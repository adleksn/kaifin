<button type="button" class="sticky-booking-cta restoplace-click-open" aria-label="Забронировать стол">
  Забронировать стол
</button>

<script>
  const cta = document.querySelector<HTMLButtonElement>('.sticky-booking-cta');
  const updateVisibility = () => cta?.classList.toggle('is-visible', window.scrollY > window.innerHeight * 0.72);

  updateVisibility();
  window.addEventListener('scroll', updateVisibility, { passive: true });
</script>
