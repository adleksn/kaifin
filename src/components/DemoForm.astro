---
interface Props { kind: 'banquet' | 'career'; }
const { kind } = Astro.props; const isBanquet = kind === 'banquet';
---
<form class="demo-form" data-demo-form novalidate><div class="demo-form__head"><p class="eyebrow">{isBanquet ? 'Заявка на банкет' : 'Анкета кандидата'}</p><h2>{isBanquet ? 'Расскажите о вашем событии' : 'Давайте познакомимся'}</h2><p>Форма уже готова, но отправка заявок будет подключена при переносе сайта.</p></div><div class="demo-form__fields">{isBanquet && <><label>Дата мероприятия<input type="date" name="date" required /></label><label>Количество гостей<input type="number" name="guests" min="1" placeholder="Например, 30" required /></label><label>Формат<select name="format" required><option value="">Выберите формат</option><option>День рождения</option><option>Свадьба</option><option>Корпоратив</option><option>Другое событие</option></select></label></>}{isBanquet ? null : <label>Желаемая роль<select name="role" required><option value="">Выберите вакансию</option><option>Менеджер</option><option>Официант</option><option>Бармен</option><option>Повар</option><option>Другая роль</option></select></label>}<label>Ваше имя<input name="name" autocomplete="name" placeholder="Как к вам обращаться" required /></label><label>Телефон<input name="phone" type="tel" autocomplete="tel" placeholder="+7 999 000-00-00" required /></label><label class="demo-form__wide">Комментарий<textarea name="comment" placeholder={isBanquet ? 'Пожелания к празднику' : 'Расскажите об опыте'}></textarea></label><label class="demo-form__wide checkbox-line"><input type="checkbox" required /><span>Согласен(на) с <a href="/privacy">политикой конфиденциальности</a>.</span></label><button type="submit">{isBanquet ? 'Оставить заявку' : 'Оставить отклик'}</button><p class="form-status" aria-live="polite"></p></div></form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-demo-form]').forEach((form) => form.addEventListener('submit', (event) => { event.preventDefault(); const status = form.querySelector<HTMLElement>('.form-status'); if (!form.checkValidity()) { status!.textContent = 'Заполните обязательные поля, чтобы продолжить.'; return; } status!.textContent = 'Спасибо! Отправка будет подключена вместе с системой сайта.'; }));
</script>
