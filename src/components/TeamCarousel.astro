---
import { teamRoles } from '../data/site';
---
<section class="team-carousel" aria-label="Команда Кайфына"><div class="team-track" id="team-track">{teamRoles.map((member, index) => <article class:list={['team-slide', { 'is-featured': index === 1 }]}><div class="team-avatar" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div><p class="eyebrow">{member.role}</p><h2>{member.caption}</h2></article>)}</div><div class="team-carousel__controls"><button type="button" data-team-direction="-1" aria-label="Предыдущая карточка">←</button><button type="button" data-team-direction="1" aria-label="Следующая карточка">→</button></div></section>
<script>
  const bindTeamCarousels = () => document.querySelectorAll<HTMLElement>('.team-carousel').forEach((carousel) => {
    if (carousel.dataset.controlsBound) return;
    carousel.dataset.controlsBound = 'true';
    carousel.querySelectorAll<HTMLButtonElement>('[data-team-direction]').forEach((button) => button.addEventListener('click', () => {
      carousel.scrollBy({ left: Number(button.dataset.teamDirection) * 300, behavior: 'auto' });
    }));
  });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindTeamCarousels, { once: true });
  else bindTeamCarousels();
</script>
