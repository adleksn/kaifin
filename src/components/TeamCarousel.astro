---
import { teamRoles, withBase } from '../data/site';
---
<section class="team-carousel" aria-label="Команда Кайфына">
  <div class="team-carousel__stage" data-team-stage>
    <div class="team-carousel__viewport" data-team-viewport>
      <div class="team-track">
        {teamRoles.map((member, index) => <article class:list={['team-slide', index === 1 && 'is-active', index === 0 && 'is-previous', index === 2 && 'is-next']} data-team-slide>
          <div class="team-member-card">
            <img class="team-member-card__image" src={member.image} alt={member.title || member.role} loading="lazy" style={`object-position:${member.position}`} />
            <div class="team-member-card__overlay">
              <h2 class="team-member-card__name">{member.title || member.role}</h2>
              <p class="team-member-card__position">{[member.role, member.positionTitle].filter(Boolean).join(' · ')}</p>
            </div>
          </div>
          <p class="team-member-card__caption">{member.caption}</p>
        </article>)}
      </div>
    </div>
    <div class="team-carousel__controls">
      <button type="button" data-team-direction="-1" aria-label="Предыдущая карточка">←</button>
      <button type="button" data-team-direction="1" aria-label="Следующая карточка">→</button>
    </div>
  </div>
  <a class="team-carousel__cta" href={`${withBase('/team')}#career-form`}><span>Заполни простую форму</span> и стань частью команды</a>
</section>
<script>
  const bindTeamCarousels = () => document.querySelectorAll<HTMLElement>('.team-carousel').forEach((carousel) => {
    if (carousel.dataset.controlsBound) return;
    carousel.dataset.controlsBound = 'true';
    const stage = carousel.querySelector<HTMLElement>('[data-team-stage]');
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-team-slide]')];
    if (!stage || !slides.length) return;

    let activeIndex = Math.min(1, slides.length - 1);
    let positionTimer: number | undefined;
    const positionControls = () => {
      const card = slides[activeIndex]?.querySelector<HTMLElement>('.team-member-card');
      if (!card) return;
      const stageRect = stage.getBoundingClientRect();
      const cardRect = card.getBoundingClientRect();
      carousel.style.setProperty('--team-control-top', `${cardRect.top + cardRect.height / 2 - stageRect.top}px`);
      carousel.style.setProperty('--team-control-left', `${cardRect.left - stageRect.left}px`);
      carousel.style.setProperty('--team-control-right', `${cardRect.right - stageRect.left}px`);
    };
    const setActive = (index: number) => {
      activeIndex = (index + slides.length) % slides.length;
      const previousIndex = (activeIndex - 1 + slides.length) % slides.length;
      const nextIndex = (activeIndex + 1) % slides.length;
      slides.forEach((slide, slideIndex) => {
        slide.classList.toggle('is-active', slideIndex === activeIndex);
        slide.classList.toggle('is-previous', slideIndex === previousIndex);
        slide.classList.toggle('is-next', slideIndex === nextIndex);
        slide.classList.toggle('is-hidden', slideIndex !== activeIndex && slideIndex !== previousIndex && slideIndex !== nextIndex);
      });
      requestAnimationFrame(positionControls);
      window.clearTimeout(positionTimer);
      positionTimer = window.setTimeout(positionControls, 460);
    };

    carousel.querySelectorAll<HTMLButtonElement>('[data-team-direction]').forEach((button) => button.addEventListener('click', () => setActive(activeIndex + Number(button.dataset.teamDirection))));

    let pointerId: number | undefined;
    let startX = 0;
    const stopDragging = (event?: PointerEvent) => {
      if (event && pointerId !== event.pointerId) return;
      if (event) {
        const movedX = event.clientX - startX;
        if (Math.abs(movedX) > 42) setActive(activeIndex + (movedX < 0 ? 1 : -1));
      }
      pointerId = undefined;
      carousel.classList.remove('is-dragging');
    };
    stage.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      if ((event.target as Element | null)?.closest('[data-team-direction]')) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      stage.setPointerCapture(event.pointerId);
      carousel.classList.add('is-dragging');
    });
    stage.addEventListener('pointerup', stopDragging);
    stage.addEventListener('pointercancel', stopDragging);
    window.addEventListener('resize', positionControls);

    setActive(activeIndex);
  });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindTeamCarousels, { once: true });
  else bindTeamCarousels();
</script>
