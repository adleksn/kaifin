---
import { teamRoles } from '../data/site';
---
<section class="team-carousel" aria-label="Команда Кайфына">
  <div class="team-carousel__viewport" data-team-viewport>
    <div class="team-track">{teamRoles.map((member) => <article class="team-slide"><img class="team-avatar" src={member.image} alt={member.title || member.role} loading="lazy" style={`--portrait-position:${member.position}`} /><p class="eyebrow">{member.role}</p><h2 class:list={{ 'team-slide__title': true, 'team-slide__title--empty': !member.title }} aria-hidden={member.title ? undefined : 'true'}>{member.title || '\u00a0'}</h2><p class="team-slide__caption">{member.caption}</p></article>)}</div>
  </div>
  <div class="team-carousel__controls"><button type="button" data-team-direction="-1" aria-label="Предыдущая карточка">←</button><button type="button" data-team-direction="1" aria-label="Следующая карточка">→</button></div>
</section>
<script>
  const bindTeamCarousels = () => document.querySelectorAll<HTMLElement>('.team-carousel').forEach((carousel) => {
    if (carousel.dataset.controlsBound) return;
    carousel.dataset.controlsBound = 'true';
    const viewport = carousel.querySelector<HTMLElement>('[data-team-viewport]');
    carousel.querySelectorAll<HTMLButtonElement>('[data-team-direction]').forEach((button) => button.addEventListener('click', () => {
      viewport?.scrollBy({ left: Number(button.dataset.teamDirection) * viewport.clientWidth, behavior: 'smooth' });
    }));
    if (!viewport) return;
    let pointerId: number | undefined;
    let startX = 0;
    let startScroll = 0;
    const stopDragging = () => { pointerId = undefined; carousel.classList.remove('is-dragging'); };
    viewport.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      pointerId = event.pointerId;
      startX = event.clientX;
      startScroll = viewport.scrollLeft;
      viewport.setPointerCapture(event.pointerId);
      carousel.classList.add('is-dragging');
    });
    viewport.addEventListener('pointermove', (event) => {
      if (pointerId !== event.pointerId) return;
      viewport.scrollLeft = startScroll - (event.clientX - startX);
    });
    viewport.addEventListener('pointerup', stopDragging);
    viewport.addEventListener('pointercancel', stopDragging);
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartScroll = 0;
    viewport.addEventListener('touchstart', (event) => {
      const [touch] = event.touches;
      if (!touch) return;
      touchStartX = touch.clientX;
      touchStartY = touch.clientY;
      touchStartScroll = viewport.scrollLeft;
    }, { passive: true });
    viewport.addEventListener('touchmove', (event) => {
      const [touch] = event.touches;
      if (!touch) return;
      const movedX = touch.clientX - touchStartX;
      const movedY = touch.clientY - touchStartY;
      if (Math.abs(movedX) <= Math.abs(movedY)) return;
      event.preventDefault();
      viewport.scrollLeft = touchStartScroll - movedX;
    }, { passive: false });
  });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindTeamCarousels, { once: true });
  else bindTeamCarousels();
</script>
