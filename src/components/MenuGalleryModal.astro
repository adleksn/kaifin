---
import { withBase } from '../data/site';
const pages = [withBase('/images/banquet/menu-1.jpg'), withBase('/images/banquet/menu-2.jpg')];
---
<dialog class="menu-gallery-modal" data-menu-gallery aria-label="Меню ресторана">
  <div class="menu-gallery-modal__bar"><strong>Меню</strong><div><button type="button" data-menu-gallery-zoom="-1" aria-label="Уменьшить меню">−</button><button type="button" data-menu-gallery-zoom="1" aria-label="Увеличить меню">+</button><button type="button" data-menu-gallery-close aria-label="Закрыть меню">×</button></div></div>
  <div class="menu-gallery-modal__pages" data-menu-gallery-pages>{pages.map((page, index) => <img src={page} alt={`Меню ресторана, страница ${index + 1}`} />)}</div>
</dialog>
<script>
  const modal = document.querySelector<HTMLDialogElement>('[data-menu-gallery]');
  const pages = modal?.querySelector<HTMLElement>('[data-menu-gallery-pages]');
  let zoom = 1;
  document.querySelectorAll<HTMLElement>('[data-menu-gallery-open]').forEach((trigger) => trigger.addEventListener('click', () => modal?.showModal()));
  modal?.querySelectorAll<HTMLButtonElement>('[data-menu-gallery-zoom]').forEach((button) => button.addEventListener('click', () => {
    zoom = Math.min(2, Math.max(.7, zoom + Number(button.dataset.menuGalleryZoom) * .15));
    if (pages) pages.style.setProperty('--menu-zoom', String(zoom));
  }));
  modal?.querySelector<HTMLButtonElement>('[data-menu-gallery-close]')?.addEventListener('click', () => modal.close());
  modal?.addEventListener('click', (event) => { if (event.target === modal) modal.close(); });
</script>
