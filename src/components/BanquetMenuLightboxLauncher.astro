---
import 'photoswipe/style.css';
import { menuGalleries } from '../data/site';
---

<div class="banquet-menu-lightbox-source" data-banquet-menu-lightbox aria-hidden="true">
  {Object.entries(menuGalleries).map(([key, menu]) => (
    <div data-menu-source={key}>
      {menu.pages.map((page, index) => <a href={page.src} data-pswp-width={page.width} data-pswp-height={page.height} aria-label={`${menu.label}, страница ${index + 1}`}></a>)}
    </div>
  ))}
</div>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  document.querySelectorAll<HTMLElement>('[data-menu-source]').forEach((source) => {
    const menuKey = source.dataset.menuSource;
    if (!menuKey || source.dataset.photoswipeBound) return;

    source.dataset.photoswipeBound = 'true';
    let opener: HTMLElement | null = null;
    let scrollPosition = 0;
    const lightbox = new PhotoSwipeLightbox({
      gallery: source,
      children: 'a',
      pswpModule: () => import('photoswipe'),
      wheelToZoom: true,
      initialZoomLevel: 'fit',
      secondaryZoomLevel: 2,
      maxZoomLevel: 4,
      showHideAnimationType: 'none',
      paddingFn: () => ({ top: 24, right: 24, bottom: 24, left: 24 }),
    });

    lightbox.on('beforeOpen', () => {
      scrollPosition = window.scrollY;
      document.body.classList.add('photoswipe-open');
    });

    lightbox.on('destroy', () => {
      document.body.classList.remove('photoswipe-open');
      window.scrollTo(0, scrollPosition);
      opener?.focus();
    });

    document.querySelectorAll<HTMLElement>(`[data-menu-open="${menuKey}"]`).forEach((trigger) => trigger.addEventListener('click', () => {
      opener = trigger;
      lightbox.loadAndOpen(0);
    }));

    lightbox.init();
  });
</script>
