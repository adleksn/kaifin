---
import { restaurantBooking, withBase } from '../data/site';
const links = [{ href: '#about', label: 'Ресторан' }, { href: withBase('/banquet'), label: 'Банкеты' }, { href: withBase('/loyalty'), label: 'Программа лояльности' }, { href: '#contacts', label: 'Контакты' }];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || withBase('/');
const isCurrent = (href: string) => currentPath === href.replace(/\/$/, '');
---
<header class="site-header">
  <a class="wordmark" href={withBase('/')} aria-label="Кайфын — главная">КАЙФЫН</a>
  <nav class="site-header__nav" aria-label="Основная навигация"><a href="#about">Ресторан</a><button type="button" data-menu-gallery-open>Меню</button>{links.slice(1).map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}</nav>
  <div class="site-header__actions">
    <button type="button" class="header-book restoplace-click-open">{restaurantBooking.label}</button>
    <a class="header-phone" href="tel:+79637668800">+7 963 766-88-00</a>
  </div>
  <button type="button" class="mobile-menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Открыть меню"><span></span><span></span></button>
</header>
<div class="mobile-menu" id="mobile-menu" hidden>
  <div class="mobile-menu__top"><span>Навигация</span><button type="button" class="mobile-menu__close" aria-label="Закрыть меню">×</button></div>
  <nav aria-label="Мобильная навигация"><a href="#about"><span>01</span>Ресторан</a><button type="button" data-menu-gallery-open><span>02</span>Меню</button>{links.slice(1).map((link, index) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}><span>0{index + 3}</span>{link.label}</a>)}</nav>
</div>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
  const menu = document.querySelector<HTMLElement>('.mobile-menu');
  const close = menu?.querySelector<HTMLButtonElement>('.mobile-menu__close');
  const setMenuState = (isOpen: boolean) => {
    if (!menu || !toggle) return;
    menu.hidden = !isOpen;
    toggle.setAttribute('aria-expanded', String(isOpen));
    document.body.classList.toggle('menu-open', isOpen);
    if (isOpen) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    else toggle.focus();
  };
  toggle?.addEventListener('click', () => setMenuState(toggle.getAttribute('aria-expanded') !== 'true'));
  close?.addEventListener('click', () => setMenuState(false));
  menu?.querySelectorAll('a').forEach((item) => item.addEventListener('click', () => setMenuState(false)));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setMenuState(false); });
</script>
