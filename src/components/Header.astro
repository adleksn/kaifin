---
import { restaurantBooking } from '../data/site';
const links = [{ href: '/loyalty', label: 'Программа лояльности' }, { href: '/banquet', label: 'Банкет' }, { href: '/about', label: 'О нас' }, { href: '/promotions', label: 'Акции' }, { href: '/team', label: 'Команда' }];
---
<header class="site-header"><a class="wordmark" href="/" aria-label="Кайфын — главная">КАЙФЫН</a><nav aria-label="Основная навигация">{links.map((link) => <a href={link.href}>{link.label}</a>)}</nav><a class="header-book" href={restaurantBooking.href}>{restaurantBooking.label}</a></header>
