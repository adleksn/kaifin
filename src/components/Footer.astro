---
import { site } from '../data/site';
const mapLink = `https://yandex.ru/maps/?text=${encodeURIComponent(site.address)}`;
---
<footer class="site-footer">
  <section class="map-placeholder" aria-label="Карта расположения ресторана">
    <div><span>Кайфын</span><p>{site.address}</p></div>
    <a href={mapLink} target="_blank" rel="noreferrer">Как добраться ↗</a>
  </section>
  <div class="footer-meta">
    <div><div class="wordmark">КАЙФЫН</div><p>{site.phone}</p><a href={`mailto:${site.email}`}>{site.email}</a></div>
    <div><p>{site.hours.join(' · ')}</p><p>{site.address}</p></div>
    <div><a href="/privacy">Политика конфиденциальности</a><a href="/contacts">Контакты</a></div>
  </div>
</footer>
