---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamCarousel from '../components/TeamCarousel.astro';
import DemoForm from '../components/DemoForm.astro';
---
<BaseLayout title="Команда — Кайфын"><section class="inner-hero team-hero"><p class="eyebrow">Люди Кайфына</p><h1>Команда, которая<br />создаёт вечер</h1><p class="lede">Узнаем друг друга ближе — а пока ищем тех, кто хочет делать гостям хорошо.</p></section><TeamCarousel /><section class="career-callout"><p class="eyebrow">Карьера в Кайфыне</p><h2>Присоединяйтесь<br />к команде</h2><p>Менеджеры, официанты, бармены, повара — будем рады познакомиться.</p></section><DemoForm kind="career" /></BaseLayout>
