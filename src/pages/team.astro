---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamCarousel from '../components/TeamCarousel.astro';
import DemoForm from '../components/DemoForm.astro';
---
<BaseLayout title="Команда — Кайфын"><section class="inner-hero team-hero"><p class="eyebrow">Люди Кайфына</p><h1>Люди, которые создают атмосферу</h1><p class="lede">За вкусом, сервисом и ощущением «здесь хорошо» всегда стоят люди.</p></section><TeamCarousel /><section class="career-callout"><p class="eyebrow">Карьера в Кайфыне</p><h2>Присоединяйтесь…</h2><p>Ищем людей, которым близки хороший сервис, уважение к гостям и любовь к своему делу.</p><p>Менеджеры, официанты, бармены, повара, курьеры — если хотите работать с нами, пройдите анкету ниже.</p></section><div id="career-form"><DemoForm kind="career" /></div></BaseLayout>
