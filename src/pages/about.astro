---
import BaseLayout from '../layouts/BaseLayout.astro';
import { generatedImages, site, withBase } from '../data/site';
---
<BaseLayout title="О ресторане — Кайфын">
  <section class="inner-hero"><p class="eyebrow">О ресторане</p><h1>Место для<br />своих историй</h1><p class="lede">Ресторан «Кайфын» расположен в микрорайоне Ольгино города Балашиха — в тихом и уютном районе недалеко от центра Железнодорожного.</p></section>
  <section class="about-story"><div class="image-block" style={`background-image:url('${generatedImages.about}')`}></div><div><p class="eyebrow">История названия</p><h2>Кайфын — про момент, в котором хочется остаться.</h2><p>Так мы называем вечер, когда за одним столом собираются близкие, разговор идёт легко, а время перестаёт спешить. От этого настроения и родилось имя ресторана.</p><p>Здесь европейская и азиатская кухня встречаются с хорошей музыкой, тёплым светом и поводом задержаться ещё немного. В «Кайфыне» можно устроить обычный ужин, семейную встречу или большой праздник — и оставить место для своего сценария.</p><a href={withBase('/menu')}>Посмотреть меню →</a></div></section>
  <section class="kids-section" id="kids" style={`--kids-image:url('${generatedImages.kids}')`}><div><p class="eyebrow">Для семей</p><h2>Детская комната</h2><p>Большая детская комната — часть пространства ресторана. Бронируйте семейный столик заранее, чтобы вечер был комфортным для всех гостей.</p></div><a href={withBase('/booking')}>Забронировать стол для семьи →</a></section>
  <section class="facts"><div><b>2 этажа</b><span>для разных сценариев вечера</span></div><div><b>до 150</b><span>гостей на банкет</span></div><div><b>{site.city}</b><span>мкр. Ольгино</span></div></section>
</BaseLayout>
