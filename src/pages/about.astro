---
import BaseLayout from '../layouts/BaseLayout.astro';
import RestaurantBookingCTA from '../components/RestaurantBookingCTA.astro';
import { generatedImages, withBase } from '../data/site';
---
<BaseLayout title="О ресторане — Кайфын">
  <section class="inner-hero"><p class="eyebrow">О ресторане</p><h1>Место для встреч и важных моментов</h1><p class="lede">Ресторан «Кайфын» расположен в микрорайоне Ольгино города Балашиха. К услугам гостей — уютные залы, большой банкетный зал, детская комната и бесплатная парковка.</p></section>
  <section class="about-story"><div class="image-block" style={`background-image:url('${generatedImages.about}')`}></div><div><p class="eyebrow">История названия</p><h2>Кайфын — имя с историей</h2><p>Кайфын — один из древних городов Китая и бывшая императорская столица, тесно связанная с культурой эпохи Сун.</p><p>Отсылка к Азии заложена не только в названии. В меню Кайфына встречаются два гастрономических направления — азиатская и европейская кухня.</p><p>Сегодня Кайфын — это место, которое объединяет разные форматы отдыха: ресторан, бар, кальяны, семейные встречи и большие события. Приятный интерьер, богатая барная карта, кальяны и внимательное обслуживание располагают к комфортному отдыху. Для встреч разного формата в Кайфыне есть два уютных зала: светлый зал «Аквариум» и темный барный зал. Также большой банкетный зал, детская комната и бесплатная парковка.</p><a href={withBase('/menu')}>Посмотреть меню →</a></div></section>
  <section class="kids-section" id="kids"><img class="kids-section__image" src={generatedImages.kids} alt="Детская игровая комната ресторана Кайфын" loading="lazy" /><div class="kids-section__content"><p class="eyebrow">Для семей</p><h2>Детская комната</h2><p>Для маленьких гостей в ресторане предусмотрена большая детская комната.</p><RestaurantBookingCTA class="kids-section__booking" /></div></section>
  <section class="facts"><div><b>2 этажа</b><span>с разной атмосферой на любой вкус</span></div><div><b>От камерных встреч до больших событий</b><span>Банкетный зал вместимостью до 150 гостей</span></div><div><b>Ждем вас по адресу:</b><span>г. Балашиха, микрорайон Ольгино, ул. Жилгородок, 43 А</span></div></section>
</BaseLayout>
