---
import BaseLayout from '../layouts/BaseLayout.astro';
import RestaurantBookingCTA from '../components/RestaurantBookingCTA.astro';
import { restaurantBooking, site, withBase } from '../data/site';
---
<BaseLayout title="Бронь стола — Кайфын"><section class="booking-hero" style={`background-image:url('${withBase('/images/old-site/hall-hookah.jpg')}')`}><p class="eyebrow">Бронирование</p><h1>Ваш столик<br />уже ждёт</h1><p>Выберите удобное время в виджете онлайн-бронирования.</p><RestaurantBookingCTA class="action-link" /></section><section class="booking-note"><p>Онлайн-бронирование</p><strong>Через RestoPlace</strong><span>{restaurantBooking.note}</span><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></section></BaseLayout>
