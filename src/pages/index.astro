---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoyaltyModal from '../components/LoyaltyModal.astro';
import RestaurantBookingCTA from '../components/RestaurantBookingCTA.astro';
import StickyBookingCTA from '../components/StickyBookingCTA.astro';
import TeamCarousel from '../components/TeamCarousel.astro';
import { banquetFloors, generatedImages, withBase } from '../data/site';
---
<BaseLayout>
  <section class="home-hero home-hero--structure" style={`--hero:url('${generatedImages.hero}')`}><div class="hero-copy"><p class="eyebrow">Ресторан · Балашиха</p><h1>Вечер, в котором<br />хочется остаться</h1></div><div class="hero-actions"><RestaurantBookingCTA class="hero-actions__primary" /><a href={withBase('/menu')}>Меню</a><a href={withBase('/delivery')}>Доставка</a></div></section>
  <section class="intro-grid section-space"><div class="intro-grid__left"><a href={withBase('/about')} class="story-card story-card--about" style={`background-image:linear-gradient(#0004,#0008),url('${generatedImages.about}')`}><span>О нас</span><strong>Кухня, встречи<br />и хороший свет.</strong></a><a href={`${withBase('/about')}#kids`} class="story-card story-card--kids" style={`background-image:linear-gradient(#25302680,#253026d9),url('${generatedImages.kids}')`}><span>Детская комната</span><strong>Для маленьких<br />гостей.</strong></a></div><a href={withBase('/about')} class="intro-grid__visual" style={`background-image:linear-gradient(#0001,#0007),url('${generatedImages.about}')`}><span>О ресторане</span><strong>Место для<br />ваших встреч</strong></a></section>
  <section class="banquet-section banquet-section--full"><div class="section-heading"><p class="eyebrow">Праздники в Кайфыне</p><h2><span>Банкет</span><small>ваш сценарий<br />вечера</small></h2><a href={withBase('/banquet')}>Все о банкетах →</a><RestaurantBookingCTA class="section-booking" /></div><div class="floor-grid">{banquetFloors.map((floor) => <a href={withBase(`/banquet/${floor.slug}`)} class="floor-card" style={`background-image:linear-gradient(#0003,#000a),url('${floor.hero}')`}><em>Этаж {floor.number}</em><strong>{floor.name}</strong><span>{floor.subtitle}</span></a>)}</div></section>
  <section class="service-strip service-strip--two"><a href={withBase('/promotions')}><span>01</span><b>Акции</b><em>Смотреть предложения →</em></a><a href={withBase('/loyalty')}><span>02</span><b>Программа лояльности</b><em>Получить 500 бонусов →</em></a></section>
  <section class="home-team"><div class="home-team__heading"><p class="eyebrow">Команда Кайфына</p><h2>Люди, которые<br />создают вечер</h2><a href={withBase('/team')}>Стать частью команды →</a></div><TeamCarousel /></section>
  <StickyBookingCTA /><LoyaltyModal />
</BaseLayout>
