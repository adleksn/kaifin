---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCarousel from '../components/PhotoCarousel.astro';
import LoyaltyModal from '../components/LoyaltyModal.astro';
import MenuViewer from '../components/MenuViewer.astro';
import RestaurantBookingCTA from '../components/RestaurantBookingCTA.astro';
import TeamCarousel from '../components/TeamCarousel.astro';
import { generatedImages, homeCuisine, homeSettings, homeVenue, withBase } from '../data/site';
---
<BaseLayout>
  <LoyaltyModal />
  <section class="home-hero" style={`--hero:url('${generatedImages.hero}')`}>
    <div class="hero-artwork" role="img" aria-label="Кайфын — место встречи"></div>
    <div class="home-hero__content">
      <div class="hero-copy"><h1>Ресторан китайской и европейской кухни</h1><p>Балашиха, мкр. Ольгино, ул. Жилгородок, 43А</p></div>
      <div class="hero-actions"><RestaurantBookingCTA class="hero-actions__primary" /><a href="https://kaifin-delivery.ru/">Доставка</a></div>
    </div>
  </section>

  <section id="about" class="home-story home-section">
    <div class="home-story__media">
      <img src={generatedImages.about} alt="Интерьер ресторана Кайфын" loading="lazy" />
    </div>
    <div class="home-story__content">
      <div class="home-story__copy">
        <p class="home-story__eyebrow">Восток · Запад · один стол</p>
        <h2>Ресторан «Кайфын» — место встречи</h2>
        <p>В основе визуального языка — образ Шёлкового пути, который веками соединял Восток и Запад, разные культуры, традиции и вкусы.</p>
        <p>Эта идея отражается и в интерьере, и в фирменном стиле, и в кухне ресторана. Плавные линии, природные фактуры и образы маршрутов символизируют движение и соединение разных культур.</p>
        <p>«Кайфын» — это место, где Восток и Запад встречаются за одним столом, а знакомые вкусы открываются по-новому.</p>
      </div>
    </div>
  </section>

  <section id="cuisine" class="home-cuisine home-section">
    <div class="home-section__heading"><h2>{homeCuisine.title}</h2><p>{homeCuisine.description}</p></div>
    <PhotoCarousel ariaLabel="Кухня Кайфына" images={homeCuisine.images} className="home-venue__gallery kitchen-showcase__carousel" />
    <div class="home-cuisine__actions"><MenuViewer menuKey="main" /><MenuViewer menuKey="kids" /><MenuViewer menuKey="hookah" /><MenuViewer menuKey="banquet" /></div>
  </section>

  <section class="home-venue home-section">
    <div class="home-section__heading"><h2>{homeVenue.title}</h2><p>{homeVenue.description}</p></div>
    <div class="home-venue__facts">{homeVenue.facts.map((fact) => <div><strong>{fact.value}</strong><span>{fact.label}</span></div>)}</div>
    <PhotoCarousel ariaLabel="Пространство ресторана" images={homeVenue.images} className="home-venue__gallery" />
  </section>

  {homeSettings.showTeamOnHome && <section class="home-team"><div class="home-team__heading"><h2>Команда Кайфына</h2><p>Люди, которые создают атмосферу ресторана.</p><a class="text-link" href={withBase('/team')}>Познакомиться с командой</a></div><TeamCarousel /></section>}
</BaseLayout>
