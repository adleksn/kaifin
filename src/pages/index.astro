---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoyaltyModal from '../components/LoyaltyModal.astro';
import RestaurantBookingCTA from '../components/RestaurantBookingCTA.astro';
import StickyBookingCTA from '../components/StickyBookingCTA.astro';
import TeamCarousel from '../components/TeamCarousel.astro';
import { banquetFloors, generatedImages, withBase } from '../data/site';
---
<BaseLayout>
  <section class="home-hero home-hero--structure" style={`--hero:url('${generatedImages.hero}')`}><div class="hero-copy"><p class="eyebrow">Ресторан · Балашиха</p><h1>Вечер, в котором<br />хочется остаться</h1></div><div class="hero-actions"><RestaurantBookingCTA class="hero-actions__primary" /><a href={withBase('/menu')}>Меню</a><a href={withBase('/delivery')}>Доставка</a></div></section>
  <section class="intro-grid section-space"><div class="intro-grid__left"><a href={withBase('/about')} class="story-card story-card--text"><span>О нас</span><strong>Городской ресторан для вашего ритма жизни</strong><p>Встретиться, поужинать, отметить важное или просто хорошо провести вечер.</p></a><a href={`${withBase('/about')}#kids`} class="story-card story-card--kids" style={`background-image:linear-gradient(#25302680,#253026d9),url('${generatedImages.kids}')`}><span>Детская комната</span><strong>Для маленьких гостей — своё пространство для игр и весёлого отдыха.</strong></a></div><a href={withBase('/about')} class="intro-grid__visual" style={`background-image:url('${generatedImages.food}')`} aria-label="О ресторане"></a></section>
  <section class="banquet-section banquet-section--full"><div class="section-heading"><p class="eyebrow">Праздники и банкеты</p><h2><span>Большие торжества и камерные встречи — создаём праздники любого формата для самых важных поводов.</span></h2><a href={withBase('/banquet')}>Подробнее о банкетах →</a><a class="section-booking" href={withBase('/banquet')}>Забронировать банкет</a></div><div class="floor-grid">{banquetFloors.map((floor) => <a href={withBase(`/banquet/${floor.slug}`)} class="floor-card" style={`background-image:linear-gradient(#0003,#000a),url('${floor.hero}')`}><strong>{floor.name}</strong><span>{floor.subtitle}</span></a>)}</div></section>
  <section class="service-strip service-strip--two"><a href={withBase('/promotions')}><span>01</span><b>Акции</b><em>Смотреть предложения →</em></a><a href={withBase('/loyalty')}><span>02</span><b>Программа лояльности</b><em>Получить 500 бонусов →</em></a></section>
  <section class="home-team"><div class="home-team__heading"><p class="eyebrow">Команда Кайфына</p><h2>Люди, которые<br />создают вечер</h2><p>За каждым вечером в Кайфыне — команда, которая отвечает за вкус, атмосферу и внимание к деталям.</p><a href={withBase('/team')}>Заполни простую форму и стань частью команды</a></div><TeamCarousel /></section>
  <StickyBookingCTA /><LoyaltyModal />
</BaseLayout>
