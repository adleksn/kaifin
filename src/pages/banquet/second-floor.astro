---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoForm from '../../components/DemoForm.astro';
import { banquetFloors, withBase } from '../../data/site';
const floor = banquetFloors[1];
---
<BaseLayout title="2 этаж — банкетный — Кайфын">
  <section class="booking-hero" style={`background-image:linear-gradient(90deg,#171916e8,#17191699),url('${floor.hero}')`}><p class="eyebrow">Банкеты · этаж 02</p><h1>{floor.name}</h1><p>{floor.subtitle}</p><a class="action-link" href="#banquet-request">Забронировать дату</a><a class="text-link" href={withBase('/banquet')}>Все о банкетах →</a></section>
  <section class="hall-details hall-conditions">{floor.conditions.map((condition, index) => <div><span>Условие 0{index + 1}</span><b>{condition}</b></div>)}</section>
  <section class="room-gallery"><figure><img src={floor.hero} alt="Банкетный зал" loading="lazy" /><figcaption>Банкетный зал</figcaption></figure></section>
  <section class="banquet-menu-viewer" aria-labelledby="banquet-menu-title"><div class="banquet-menu-viewer__heading"><p class="eyebrow">Банкетное меню</p><h2 id="banquet-menu-title">Выберите блюда<br />для вашего события</h2></div><div class="banquet-menu-pages">{floor.menuPages.map((page, index) => <figure><img src={page} alt={`Банкетное меню, страница ${index + 1}`} loading="lazy" /><figcaption>Страница {index + 1} из {floor.menuPages.length}</figcaption></figure>)}</div></section>
  <nav class="floor-switch" aria-label="Переход между этажами"><a href={withBase('/banquet/first-floor')}>← Перейти на 1 этаж</a></nav>
  <div id="banquet-request"><DemoForm kind="banquet" /></div>
</BaseLayout>
