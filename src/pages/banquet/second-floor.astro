---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoForm from '../../components/DemoForm.astro';
import PhotoCarousel from '../../components/PhotoCarousel.astro';
import MenuViewer from '../../components/MenuViewer.astro';
import { banquetFloors, hallImages, withBase } from '../../data/site';
const floor = banquetFloors[1];
---
<BaseLayout title="2 этаж — Банкетный зал — Кайфын">
  <section class="booking-hero" style={`background-image:url('${floor.hero}')`}><p class="eyebrow">Банкеты</p><h1>{floor.name}</h1><p>{floor.subtitle}</p><a class="action-link" href="#banquet-request">Забронировать дату</a><a class="text-link" href={withBase('/banquet')}>Все о банкетах →</a></section>
  <section class="hall-details hall-conditions">{floor.conditions.map((condition, index) => <div><span>Условие 0{index + 1}</span><b>{condition}</b></div>)}</section>
  <section class="hall-gallery"><div class="hall-gallery__heading"><p class="eyebrow">2 этаж</p><h2>Банкетный зал</h2></div><PhotoCarousel ariaLabel="Банкетный зал" images={hallImages.banquet} /></section>
  <section class="banquet-menu-viewer" aria-labelledby="banquet-menu-title"><div class="banquet-menu-viewer__heading"><p class="eyebrow">Банкетное меню</p><h2 id="banquet-menu-title">Выберите блюда<br />для вашего события</h2></div><PhotoCarousel className="zoomable-gallery" ariaLabel="Банкетное меню" images={floor.menuPages} /><div class="banquet-menu-viewer__actions"><MenuViewer menuKey="banquet" /></div></section>
  <nav class="floor-switch" aria-label="Переход между этажами"><a href={withBase('/banquet/first-floor')}>← Перейти на 1 этаж</a></nav>
  <div id="banquet-request"><DemoForm kind="banquet" /></div>
</BaseLayout>
