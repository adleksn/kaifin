---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { banquetFloors, withBase } from '../../data/site';
---
<BaseLayout title="Банкеты — Кайфын"><section class="inner-hero"><p class="eyebrow">Праздники и торжества</p><h1>Банкеты в ресторане «Кайфын»</h1><p class="lede">Камерный семейный праздник или большое торжество — в Кайфыне есть разные залы для любого формата события.</p><button type="button" class="action-link restoplace-click-open">Забронировать мероприятие</button></section><section class="floor-grid floor-grid--page" id="banquet-halls">{banquetFloors.map((floor) => <a href={withBase(`/banquet/${floor.slug}`)} class="floor-card" style={`background-image:url('${floor.hero}')`}><strong>{floor.name}</strong><span>{floor.subtitle}</span></a>)}</section></BaseLayout>
