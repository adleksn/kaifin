---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { banquetFloors, withBase } from '../../data/site';
---
<BaseLayout title="Банкеты — Кайфын"><section class="inner-hero"><p class="eyebrow">Праздники и торжества</p><h1>Банкеты в ресторане «Кайфын»</h1><p class="lede">Камерный семейный праздник или большое торжество — в Кайфыне есть разные залы для любого формата события.</p><p class="lede">Уточнить информацию по банкету можно по телефону: +7 963 766 88 00</p><a class="action-link" href="#banquet-halls">Забронировать мероприятие</a></section><section class="floor-grid floor-grid--page" id="banquet-halls">{banquetFloors.map((floor) => <a href={withBase(`/banquet/${floor.slug}`)} class="floor-card" style={`background-image:linear-gradient(#0003,#000a),url('${floor.hero}')`}><strong>{floor.name}</strong><span>{floor.subtitle}</span></a>)}</section></BaseLayout>
