---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoForm from '../../components/DemoForm.astro';
import PhotoCarousel from '../../components/PhotoCarousel.astro';
import { banquetFloors, hallImages, withBase } from '../../data/site';
const floor = banquetFloors[0];
---
<BaseLayout title="1 этаж — Кайфын"><section class="booking-hero" style={`background-image:linear-gradient(90deg,#171916e8,#17191699),url('${floor.hero}')`}><p class="eyebrow">Банкеты</p><h1>{floor.name}</h1><p>{floor.subtitle}</p><a class="action-link" href="#banquet-request">Забронировать дату</a><a class="text-link" href={withBase('/banquet')}>Все о банкетах →</a></section><section class="hall-details hall-conditions">{floor.conditions.map((condition, index) => <div><span>Условие 0{index + 1}</span><b>{condition}</b></div>)}</section><section class="hall-gallery"><div class="hall-gallery__heading"><p class="eyebrow">1 этаж</p><h2>Панорамный зал «Аквариум»</h2></div><PhotoCarousel ariaLabel="Панорамный зал «Аквариум»" images={hallImages.aquarium} /></section><section class="hall-gallery"><div class="hall-gallery__heading"><p class="eyebrow">1 этаж</p><h2>Бар</h2></div><PhotoCarousel ariaLabel="Бар" images={hallImages.bar} /></section><section class="banquet-menu-viewer" aria-labelledby="banquet-menu-title"><div class="banquet-menu-viewer__heading"><p class="eyebrow">Банкетное меню</p><h2 id="banquet-menu-title">Выберите блюда<br />для вашего события</h2></div><PhotoCarousel className="zoomable-gallery" ariaLabel="Банкетное меню" images={floor.menuPages} /></section><nav class="floor-switch" aria-label="Переход между этажами"><a href={withBase('/banquet/second-floor')}>Перейти на 2 этаж →</a></nav><div id="banquet-request"><DemoForm kind="banquet" /></div></BaseLayout>
