---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoForm from '../../components/DemoForm.astro';
import { banquetFloors } from '../../data/site';
const floor = banquetFloors[0];
---
<BaseLayout title="1 этаж — Кайфын"><section class="booking-hero" style={`background-image:linear-gradient(90deg,#171916e8,#17191699),url('${floor.hero}')`}><p class="eyebrow">Банкеты · этаж 01</p><h1>{floor.name}</h1><p>{floor.subtitle}</p><a class="action-link" href="#banquet-request">Забронировать дату</a><a class="text-link" href="/banquet">Все о банкетах →</a></section><section class="hall-details hall-conditions">{floor.conditions.map((condition, index) => <div><span>Условие 0{index + 1}</span><b>{condition}</b></div>)}</section><section class="room-gallery">{floor.rooms.map((room) => <figure><img src={room.image} alt={room.name} loading="lazy" /><figcaption>{room.name}</figcaption></figure>)}</section><section class="banquet-menu-viewer" aria-labelledby="banquet-menu-title"><div class="banquet-menu-viewer__heading"><p class="eyebrow">Банкетное меню</p><h2 id="banquet-menu-title">Выберите блюда<br />для вашего события</h2></div><div class="banquet-menu-pages">{floor.menuPages.map((page, index) => <figure><img src={page} alt={`Банкетное меню, страница ${index + 1}`} loading="lazy" /><figcaption>Страница {index + 1} из {floor.menuPages.length}</figcaption></figure>)}</div></section><nav class="floor-switch" aria-label="Переход между этажами"><a href="/banquet/second-floor">Перейти на 2 этаж →</a></nav><div id="banquet-request"><DemoForm kind="banquet" /></div></BaseLayout>
