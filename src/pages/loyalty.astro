---
import BaseLayout from '../layouts/BaseLayout.astro';
import { generatedImages, loyaltyProgram } from '../data/site';
---

<BaseLayout title="Программа лояльности — Кайфын" description="Программа лояльности ресторана Кайфын: бонусы от 5% до 10% с каждого чека.">
  <section class="inner-hero loyalty-program-hero">
    <h1>Программа лояльности</h1>
    <p class="loyalty-hero__gift">Дарим 500 бонусов за регистрацию в программе лояльности.</p>
    <a class="action-link primary-button" href={loyaltyProgram.registrationUrl}>Зарегистрироваться</a>
  </section>

  <section class="loyalty-program-visual" aria-label="Уровни и бонусы программы лояльности">
    <img src={generatedImages.loyaltyProgram} alt="Уровни программы лояльности: 5%, 7%, 10%; бонусы за регистрацию и оплату" loading="lazy" />
  </section>

</BaseLayout>
