---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loyalty } from '../data/site';
---
<BaseLayout title="Лояльность — Кайфын"><section class="inner-hero loyalty-hero"><p class="eyebrow">Программа лояльности</p><p class="loyalty-hero__gift">Дарим</p><h1>500 <span>БОНУСОВ</span></h1><p class="lede">за регистрацию в программе лояльности</p><p class="loyalty-choice">Выберите удобный способ регистрации:</p><div class="loyalty-page-actions"><button class="loyalty-channel loyalty-channel--vk" type="button" aria-disabled="true" title={loyalty.unavailableNote}>VK</button><button class="loyalty-channel loyalty-channel--telegram" type="button" aria-disabled="true" title={loyalty.unavailableNote}>Telegram</button><button class="loyalty-channel loyalty-channel--max" type="button" aria-disabled="true" title={loyalty.unavailableNote}>MAX</button></div></section><section class="loyalty-steps"><div><span>01</span><b>Выберите канал</b><p>Откройте удобный мессенджер и начните регистрацию.</p></div><div><span>02</span><b>Получайте бонусы</b><p>Покажите карту при заказе в ресторане.</p></div><div><span>03</span><b>Возвращайтесь</b><p>Используйте накопленные бонусы для новых встреч.</p></div></section></BaseLayout>
